{
    "name": "pl_ol_ingest_onprem_to_adls",
    "properties": {
        "activities": [
            {
                "name": "Lookup_entity_config",
                "type": "Lookup",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "JsonSource",
                        "storeSettings": {
                            "type": "AzureBlobFSReadSettings",
                            "recursive": true,
                            "enablePartitionDiscovery": false
                        },
                        "formatSettings": {
                            "type": "JsonReadSettings"
                        }
                    },
                    "dataset": {
                        "referenceName": "Ls_adls_json",
                        "type": "DatasetReference"
                    },
                    "firstRowOnly": false
                }
            },
            {
                "name": "Filter_postgresql",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "Lookup_entity_config",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_entity_config').output.value",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@equals(item().kind, 'postgres')",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "Filter_csv_src",
                "type": "Filter",
                "dependsOn": [
                    {
                        "activity": "Lookup_entity_config",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Lookup_entity_config').output.value",
                        "type": "Expression"
                    },
                    "condition": {
                        "value": "@equals(item().kind, 'csv')",
                        "type": "Expression"
                    }
                }
            },
            {
                "name": "ForEachPostgreSql",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Filter_postgresql",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Filter_postgresql').output.value",
                        "type": "Expression"
                    },
                    "isSequential": false,
                    "activities": [
                        {
                            "name": "Copy_onprem_to_adls_raw",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "PostgreSqlV2Source",
                                    "queryTimeout": "02:00:00"
                                },
                                "sink": {
                                    "type": "ParquetSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "ParquetWriteSettings"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_pg_table",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "schema": {
                                            "value": "@item().schema",
                                            "type": "Expression"
                                        },
                                        "table": {
                                            "value": "@item().table",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_adls_parquet_raw",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "folder": {
                                            "value": "@concat('raw','/','parquet')",
                                            "type": "Expression"
                                        },
                                        "file_name": {
                                            "value": "@concat(item().entity,pipeline().RunId)",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "ForEachCsv",
                "type": "ForEach",
                "dependsOn": [
                    {
                        "activity": "Filter_csv_src",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "userProperties": [],
                "typeProperties": {
                    "items": {
                        "value": "@activity('Filter_csv_src').output.value",
                        "type": "Expression"
                    },
                    "activities": [
                        {
                            "name": "Copy_Csv_to_raw",
                            "type": "Copy",
                            "dependsOn": [],
                            "policy": {
                                "timeout": "0.12:00:00",
                                "retry": 0,
                                "retryIntervalInSeconds": 30,
                                "secureOutput": false,
                                "secureInput": false
                            },
                            "userProperties": [],
                            "typeProperties": {
                                "source": {
                                    "type": "DelimitedTextSource",
                                    "storeSettings": {
                                        "type": "AzureBlobFSReadSettings",
                                        "recursive": true,
                                        "enablePartitionDiscovery": false
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextReadSettings"
                                    }
                                },
                                "sink": {
                                    "type": "DelimitedTextSink",
                                    "storeSettings": {
                                        "type": "AzureBlobFSWriteSettings"
                                    },
                                    "formatSettings": {
                                        "type": "DelimitedTextWriteSettings",
                                        "quoteAllText": true,
                                        "fileExtension": ".txt"
                                    }
                                },
                                "enableStaging": false,
                                "translator": {
                                    "type": "TabularTranslator",
                                    "typeConversion": true,
                                    "typeConversionSettings": {
                                        "allowDataTruncation": true,
                                        "treatBooleanAsNumber": false
                                    }
                                }
                            },
                            "inputs": [
                                {
                                    "referenceName": "ds_adls_csv_inbox",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "filesytem": "olistdata",
                                        "folder": {
                                            "value": "@concat('inbox','/',item().folder)",
                                            "type": "Expression"
                                        },
                                        "file": {
                                            "value": "@item().file",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ],
                            "outputs": [
                                {
                                    "referenceName": "ds_adls_csv_inbox",
                                    "type": "DatasetReference",
                                    "parameters": {
                                        "filesytem": "olistdata",
                                        "folder": {
                                            "value": "@concat('raw','/','csv','/',item().entity)",
                                            "type": "Expression"
                                        },
                                        "file": {
                                            "value": "@pipeline().RunId",
                                            "type": "Expression"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            },
            {
                "name": "Notebook_Transform_Load",
                "type": "DatabricksNotebook",
                "dependsOn": [
                    {
                        "activity": "ForEachPostgreSql",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    },
                    {
                        "activity": "ForEachCsv",
                        "dependencyConditions": [
                            "Succeeded"
                        ]
                    }
                ],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "notebookPath": "/Users/bhanutejachindukuri@gmail.com/Qvc_data_engineer_problem/transform_olist",
                    "baseParameters": {
                        "run_id": {
                            "value": "@pipeline().RunId",
                            "type": "Expression"
                        },
                        "raw_base_path": "abfss://olistdata@datasource4dbs.dfs.core.windows.net/raw"
                    }
                },
                "linkedServiceName": {
                    "referenceName": "Ls_Data_bricks",
                    "type": "LinkedServiceReference"
                }
            }
        ],
        "annotations": []
    }
}